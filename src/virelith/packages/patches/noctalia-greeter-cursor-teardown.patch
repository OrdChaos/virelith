--- a/src/compositor/noctalia_compositor.c
+++ b/src/compositor/noctalia_compositor.c
@@ -2155,6 +2155,23 @@
   }
   cleanup_server_listeners(&server);
   wl_display_destroy_clients(server.display);
+  /* Disable all outputs (and the DRM backend) before destroying the
+   * display.  wl_display_destroy() frees Wayland globals without
+   * running their destructors, so without this the wlroots DRM
+   * backend never commits the primary/cursor plane disable and the
+   * hardware cursor plane survives the compositor handoff: the next
+   * compositor on the seat starts over a stale "ghost" cursor
+   * showing this greeter's last cursor image.  Destroying the
+   * outputs explicitly makes dealloc_crtc() issue the plane-disable
+   * commit while the greeter session still holds DRM master. */
+  {
+    struct greeter_output* output;
+    struct greeter_output* output_tmp;
+    wl_list_for_each_safe(output, output_tmp, &server.outputs, link) {
+      wlr_output_destroy(output->wlr_output);
+    }
+    wlr_backend_destroy(server.backend);
+  }
   wl_display_destroy(server.display);
   return 0;
 }

   }
   const enum wl_output_transform transform = transform_for_output(server, output->wlr_output->name);
   wlr_output_state_set_transform(&state, transform);
+  /* wlroots renders the hardware cursor buffer without accounting
+   * for the connector's panel orientation, so on outputs whose
+   * effective orientation (synced transform composed with the panel
+   * orientation) is non-normal the hardware cursor appears rotated
+   * relative to the rest of the UI.  The software cursor path is
+   * drawn into the properly transformed frame, so lock software
+   * cursors for those outputs only; normal-orientation outputs keep
+   * the hardware cursor. */
+  {
+    enum wl_output_transform effective = transform;
+    enum wl_output_transform panel =
+        wlr_drm_connector_get_panel_orientation(output->wlr_output);
+    if (panel != WL_OUTPUT_TRANSFORM_NORMAL) {
+      effective = wlr_output_transform_compose(effective, panel);
+    }
+    if (effective != WL_OUTPUT_TRANSFORM_NORMAL) {
+      wlr_output_lock_software_cursors(output->wlr_output, true);
+    }
+  }
   const int mode_width = mode != NULL ? mode->width : 0;
   const int mode_height = mode != NULL ? mode->height : 0;
   const float scale = output_ui_scale(server, output->wlr_output, mode_width, mode_height);
